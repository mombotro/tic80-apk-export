+        if (sGameToLaunch == null) {
+            sGameToLaunch = copyBundledCart();
+        }
+
         super.onCreate(savedInstanceState);
     }
 
+    private String copyBundledCart() {
+        File out = new File(getCacheDir(), "cart.tic");
+        try (InputStream in = getAssets().open("cart.tic");
+             FileOutputStream os = new FileOutputStream(out)) {
+            byte[] buffer = new byte[4096];
+            int n;
+            while ((n = in.read(buffer)) != -1) {
+                os.write(buffer, 0, n);
+            }
+            return out.getAbsolutePath();
+        } catch (Exception e) {
+            Log.e("TIC", "Error copying bundled cart", e);
+            return null;
+        }
+    }
